{
    "name": "subodh/smart-ai-assistant",
    "description": "A reusable Laravel package providing a smart AI assistant for AEPS error handling.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Subodh",
            "email": "subodh@example.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^10.0|^11.0",
        "phpoffice/phpspreadsheet": "^1.29"
    },
    "suggest": {
        "smalot/pdfparser": "Needed to ingest PDF documents with smart-ai:ingest (^2.12)",
        "anthropic-ai/sdk": "Needed for document answers with ai.driver = anthropic (^0.57)"
    },
    "autoload": {
        "psr-4": {
            "Subodh\\SmartAiAssistant\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Subodh\\SmartAiAssistant\\SmartAiAssistantServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^11.0",
        "smalot/pdfparser": "^2.12",
        "anthropic-ai/sdk": "^0.57"
    },
    "autoload-dev": {
        "psr-4": {
            "Subodh\\SmartAiAssistant\\Tests\\": "tests/",
            "Cartalyst\\Sentinel\\Laravel\\Facades\\": "tests/Stubs/Sentinel/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
